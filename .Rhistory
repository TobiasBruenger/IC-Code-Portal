geom_hline(yintercept = lower25, linetype = "dashed", size =1, color = "orange")+
geom_segment(
aes(x = selected_pos - 150, y = mtr_sel-0.1,
xend = selected_pos, yend = mtr_sel),
arrow = arrow(length = unit(0.5, "cm")),
size = 2,
color = "magenta"
) +
theme_classic(base_size = 20)+
