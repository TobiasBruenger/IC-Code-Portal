# Add text including both number of individuals and percentage impairments
df_summary <- df_summary %>%
rowwise() %>%
mutate(
text_info = paste0(
"Number of individuals: ", `Number of individuals`, "\n",
round(`Language Domain_imp_percent`), "% Language Domain\n",
round(`Memory Domain_imp_percent`), "% Memory Domain\n",
round(`Executive Function Domain_imp_percent`), "% Executive Domain\n",
round(`Attention/Processing Speed Domain_imp_percent`), "% Attention/Processing Speed Domain\n",
round(`Visuospatial Domain_imp_percent`), "% Visuospatial Domain"
),
text_info_simp = paste0(
"Number of individuals: ", `Number of individuals`, "\n"
)
) %>%
group_by(Phenotype) %>%
group_modify(~{
if(unique(.x$Phenotype) == "Bi-domain") {
# each row: which domains impaired
combos <- .x %>%
mutate(impaired = pmap(domain_cols, ~ c(...))) %>%
mutate(impaired = map(impaired, ~ domain_cols[.x == "impaired"])) %>%
pull(impaired)
# all pairs across individuals
pairs <- unlist(
map(combos, ~ if(length(.x) >= 2) combn(.x, 2, simplify = FALSE) else NULL),
recursive = FALSE
)
# count pairs
pair_df <- tibble(pair = map_chr(pairs, ~ paste(sort(.x), collapse = "|")))
pair_counts <- pair_df %>%
count(pair) %>%
mutate(pct = round(100 * n / sum(n))) %>%
mutate(text = paste0(
pct, "% ",
str_replace(pair, "\\|", "/") %>%
str_replace_all(domain_names)
))
# build text_info
bi_text <- paste0(
"Number of individuals: ", unique(.x$`Number of individuals`), "\n",
paste(pair_counts$text, collapse = "\n")
)
.x$text_info <- bi_text
.x
} else {
.x
}
}) %>%
ungroup() %>%
mutate(text_info = ifelse(Phenotype %in% c("Single Domain","Bi-domain"),text_info,text_info_simp))
# Add text including both number of individuals and percentage impairments
df_summary <- df_summary %>%
rowwise() %>%
mutate(
text_info = if (Phenotype == "Bi-domain") {
# extract impaired domains for this row
impaired <- c_across(all_of(domain_cols))
impaired <- domain_cols[impaired == "impaired"]
# get all possible pairs if >=2 domains impaired
if (length(impaired) >= 2) {
pair <- paste(sort(impaired)[1:2], collapse = "|")
display_pair <- gsub("\\|", "/", pair)
display_pair <- str_replace_all(display_pair, display_names)
# each person = one vote for their pair; you already know Bi-domain ⇒ 2 domains
paste0(
"Number of individuals: ", `Number of individuals`, "\n",
"50% ", display_pair, "\n"
)
} else {
# fallback
paste0("Number of individuals: ", `Number of individuals`, "\n")
}
} else {
# ORIGINAL logic for non-Bi domain rows
paste0(
"Number of individuals: ", `Number of individuals`, "\n",
round(`Language Domain_imp_percent`), "% Language Domain\n",
round(`Memory Domain_imp_percent`), "% Memory Domain\n",
round(`Executive Function Domain_imp_percent`), "% Executive Domain\n",
round(`Attention/Processing Speed Domain_imp_percent`), "% Attention/Processing Speed Domain\n",
round(`Visuospatial Domain_imp_percent`), "% Visuospatial Domain"
)
}
) %>%
ungroup()
