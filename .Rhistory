uploaded_table <- read_excel("C:/Users/tobia/Downloads/Tobias Test - Large Dataset2.xlsx", guess_max = 100000)
twolists <- process_data(uploaded_table,"1SD")
process_data <- function(uploaded_table, selected_cutoffs) {
# Modify cutoffs
selected_cutoffs <- str_remove(selected_cutoffs, "standard deviation") %>% str_remove(., "s") %>% as.numeric()
# Remove columns and rows that have been accidentally added
accepted_columns <- c("StudyID", colnames(uploaded_table)[colnames(uploaded_table) %>% str_detect(., ":")], colnames(uploaded_table)[colnames(uploaded_table) %>% str_detect(., "Filter")])
uploaded_table <- uploaded_table %>% select(any_of(accepted_columns))
uploaded_table <- uploaded_table %>% slice(which(rowSums(!is.na(uploaded_table)) > 1))
# add fake study ID if missing
if(any(colnames(uploaded_table) == "StudyID")){
#do nothing all good
} else{
# add Study ID numeric
uploaded_table <- uploaded_table %>%
mutate(StudyID = 1:nrow(.))
}
# Without StudyID and mood
workingtable <- uploaded_table %>% select(-StudyID, -any_of(which(str_detect(colnames(uploaded_table), "MOOD :"))), -any_of(which(str_detect(colnames(uploaded_table), "Filter_"))))
# Mood separately
moodtable <- uploaded_table %>% select(which(str_detect(colnames(uploaded_table), "MOOD :")))
# Extract filter columns
filtertable <- uploaded_table %>% select(starts_with("Filter_")) %>% select(where(~ !all(is.na(.))))
# Normalize all scores regardless of which scale they used
workingtable_norm <- workingtable
for (col_i in 1:ncol(workingtable)) {
for (row_i in 1:nrow(workingtable)) {
scale_name <- colnames(workingtable)[col_i] %>% str_split("-- ", simplify = TRUE) %>% .[, 2]
if (scale_name == "Scaled Score (M=10, SD=3)") {
workingtable_norm[row_i, col_i] <- scaled_to_standard(workingtable[row_i, col_i])
} else if (scale_name == "T-score (M=50, SD=10)") {
workingtable_norm[row_i, col_i] <- t_to_standard(workingtable[row_i, col_i])
} else if (scale_name == "Z-score (M=0, SD=1)") {
workingtable_norm[row_i, col_i] <- z_to_standard(workingtable[row_i, col_i])
} else if (scale_name == "Percentile Score (%tile)") {
workingtable_norm[row_i, col_i] <- percentile_to_standard(workingtable[row_i, col_i])
}
}
}
domains <- c("LANGUAGE", "MEMORY", "EXECUTIVE_FUNCTION", "ATTENTION_PROCESSING_SPEED", "VISUOSPATIAL")
process_phenotype_data <- function(workingtable, cutoff, use_warning = FALSE) {
func <- if (use_warning) is_impaired_group_with_warning else is_impaired_group
workingtable_stand <- workingtable %>% mutate(across(everything(), ~func(.x, cutoff)))
summary_table.df <- tibble(
"Language Domain" = NA,
"Number Language Domain Tests" = NA,
"Memory Domain" = NA,
"Number Memory Domain Tests" = NA,
"Executive Function Domain" = NA,
"Number Executive Function Domain Tests" = NA,
"Attention/Processing Speed Domain" = NA,
"Number Attention/Processing Speed Domain Tests" = NA,
"Visuospatial Domain" = NA,
"Number Visuospatial Domain Tests" = NA,
"Phenotype" = NA,
"Number of Domains" = NA
)
for (domain_sel in domains) {
i <- which(str_detect(colnames(workingtable_stand), domain_sel))
domain_i <- which(domain_sel == domains)
number_tests <- ifelse(identical(i, integer(0)), 0, length(i))
for (row in 1:nrow(workingtable_stand)) {
if (!identical(i, integer(0))) { # no data available for this domain
n_impaired <- workingtable_stand[row, i] %>% str_count("impaired") %>% sum()
n_missing <- workingtable_stand[row, i] %>% str_count("No data provided") %>% sum()
n_assessed <- number_tests - n_missing
domain_class <- case_when(
n_impaired > 1 ~ "impaired",
any(workingtable_stand[row, i] != "No data provided") & n_assessed > 1 ~ "intact",
any(workingtable_stand[row, i] != "No data provided") ~ "Not sufficient tests provided",
TRUE ~ "No data provided for this domain"
)
summary_table.df[row, (domain_i * 2 - 1)] <- domain_class
summary_table.df[row, (domain_i * 2)] <- number_tests - n_missing
} else {
summary_table.df[row, (domain_i * 2 - 1)] <- "No data provided"
summary_table.df[row, (domain_i * 2)] <- 0
}
}
}
for (i in 1:nrow(summary_table.df)) {
domains_assesed <- summary_table.df[i, c(1, 3, 5, 7, 9)] %>% str_count("impaired") %>% sum() + summary_table.df[i, c(1, 3, 5, 7, 9)] %>% str_count("intact") %>% sum()
n_impaired <- summary_table.df[i, c(1, 3, 5, 7, 9)] %>% str_count("impaired") %>% sum()
domain_pheno <- case_when(
domains_assesed < 4 ~ "Not sufficient domains assessed",
n_impaired == 0 ~ "Intact",
n_impaired == 1 ~ "Single Domain",
n_impaired == 2 ~ "Bi-domain",
n_impaired > 2 ~ "Generalized"
)
summary_table.df$Phenotype[i] <- domain_pheno
summary_table.df$`Number of Domains`[i] <- domains_assesed
}
# Mood phenotype part
summary_mood.df <- moodtable
if (ncol(moodtable) > 0) {
for (testname in colnames(moodtable)) {
testname_short <- str_remove(testname, "MOOD : ")
if (any(names(score_interpretations$Depression) == testname_short)) {
summary_mood.df[testname] <- sapply(moodtable[testname] %>% unlist(), function(score) {
generate_modifier_output("Depression", testname_short, score)
})
} else {
summary_mood.df[testname] <- sapply(moodtable[testname] %>% unlist(), function(score) {
generate_modifier_output("Anxiety", testname_short, score)
})
}
}
}
summary_table.df$Cutoff <- cutoff
list(summary_table = summary_table.df, workingtable_stand = workingtable_stand, summary_mood = summary_mood.df)
}
resultlist <- list()
downloadlist <- list()
for (cutoff in selected_cutoffs) {
index <- which(cutoff == selected_cutoffs)
result_data <- process_phenotype_data(workingtable_norm, cutoff, use_warning = FALSE)
download_data <- process_phenotype_data(workingtable_norm, cutoff, use_warning = TRUE)
resultlist[[index]] <- cbind(result_data$summary_table, filtertable)
downloadtable <- cbind(uploaded_table %>% select(StudyID), download_data$summary_table %>% select(Phenotype, `Number of Domains`)) %>%
mutate(Cutoff = cutoff)
for (domain_sel in domains) {
i <- which(str_detect(colnames(result_data$workingtable_stand), domain_sel))
domain_i <- which(domain_sel == domains)
summary_table_cols <- c((domain_i * 2 - 1), (domain_i * 2))
downloadtable <- cbind(downloadtable,
download_data$summary_table %>% select(all_of(summary_table_cols)),
download_data$workingtable_stand %>% select(i))
}
if (ncol(moodtable) > 0) {
result_data$summary_table <- cbind(result_data$summary_table, result_data$summary_mood)
downloadtable <- cbind(downloadtable, download_data$summary_mood)
}
downloadlist[[index]] <- cbind(downloadtable, filtertable)
}
downloadtable_final <- tibble()
for (i in 1:length(downloadlist)) {
downloadtable_final <- rbind(downloadtable_final,downloadlist[[i]])
}
return(list(resultlist = resultlist, downloadtable_final = downloadtable_final, filtertable = filtertable))
}
is_impaired_group <- function(value, sd_threshold) {
case_when(
is.na(value) ~ "No data provided",
value < (100 - (15 * sd_threshold)) ~ "impaired",
TRUE ~ "intact"
)
}
is_impaired_group_with_warning <- function(value, sd_threshold) {
warning_threshold <- 100 - (3 * 15)
case_when(
is.na(value) ~ "No data provided",
value < (100 - (15 * sd_threshold)) ~ {
ifelse(value < warning_threshold, "impaired (Unusual low value detected)", "impaired")
},
TRUE ~ "intact"
)
}
