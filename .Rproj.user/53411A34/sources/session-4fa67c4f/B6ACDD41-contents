  # Function to create observers based on the provided list
  createObservers <- function(test_names, values) {
    # Define a reactive function to calculate the count of valid entries
    # Define the reactive function to calculate the count of valid entries for a specific domain
    countValidEntries <- function(domain) {
      count <- 0
      for (test_name in test_names) {
        sanitized_name <- sanitizeTestName(test_name)
        value_inputId  <- paste0(sanitized_name, "_value")
        if ( category_to_domain[[ test_to_category(test_name) ]] == domain &&
             !is.null(input[[value_inputId]]) && !is.na(input[[value_inputId]]) ) {
          count <- count + 1
        }
      }
      return(count)
    }

    
    for (test_name in test_names) {
      sanitized_name <- sanitizeTestName(test_name)
      category_name <- test_to_category(test_name)
      local({
        value_inputId <- paste0(sanitized_name, "_value")
        scale_inputId <- paste0(sanitized_name, "_scale")
        checkbox_inputId <- paste0(sanitized_name, "_checkbox")
        
        # Store sanitized_name in a local environment to force evaluation
        local_sanitized_name <- sanitized_name
        category_name_local <- category_name
        # Get domain name given a category 
        domain <- category_to_domain[[category_name_local]]
        
        # Observe all inputs for the current test
        observe({
          # Update numeric input value
          values[[value_inputId]] <- input[[value_inputId]]
          
          # Update select input value
          values[[scale_inputId]] <- input[[scale_inputId]]
          
          # Update checkbox input value
          values[[checkbox_inputId]] <- input[[checkbox_inputId]]
          # Update warning message
          observeWarningMessage(input[[value_inputId]], input[[scale_inputId]], paste0(local_sanitized_name, "_warning_message_sd"))
        })
        
        # Track changes in inputs and update counters
        observeEvent(c(input[[checkbox_inputId]], input[[value_inputId]]), {
          count <- countValidEntries(domain)#countValidEntries()
          # Update the selected_tests counter for the corresponding domain
          selected_tests[[domain]] <- count
        })
      })
    }
  }
  
  
  createObservers(unlist(all_tests), values)
  

