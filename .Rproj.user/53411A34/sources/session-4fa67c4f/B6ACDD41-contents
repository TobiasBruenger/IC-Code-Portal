          impaired_domains_int <- unique(identified_domain_filt)
          impaired_domains <- paste(impaired_domains_int, collapse = ", ")
        } else {
          impaired_tot <- FALSE
          impaired_domains <- ""
          identified_domains <- c()
          impaired_domains_int <- c()
          identified_domain_filt <- character(0)
