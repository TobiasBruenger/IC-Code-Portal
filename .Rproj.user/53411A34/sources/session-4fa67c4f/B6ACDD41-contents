#Transform sores 
# #calculate ouput ####
scaled_to_standard <- function(scaled_score) {
  return((scaled_score - 10) * (15/3) + 100)
}

t_to_standard <- function(t_score) {
  return((t_score - 50) * (15/10) + 100)
}


z_to_standard <- function(z_score) {
  return((z_score - 0) * (15/1) + 100)
}

percentile_to_standard <- function(percentile_score) {

  z_score <- qnorm(percentile_score / 100)
  
  # Convert the Z-score to a standard score
  return((z_score * 15) + 100)
}


#function to take any score and any value and transform it to the stanard score

transform_score <- function(score, scale, checkbox) {
  
  if(is.null(checkbox) | is.null(score) |is.null(scale)){
    return(100)
  } else if (is.na(score)){
    return(100) 
  } else {
    if(!is.null(checkbox) & checkbox) {
      if(scale == "Scaled Score (M=10, SD=3)") {
        return(scaled_to_standard(score))
      } else if(scale == "T-score (M=50, SD=10)") {
        return(t_to_standard(score))
      } else if (scale == "Z-score (M=0, SD=1)") {
        return(z_to_standard(score))
      } else if (scale == "Percentile Score (%tile)") {
        return(percentile_to_standard(score))
      } else {
        return(score)
      }
    } else {
      return(100) # average score, will not be counted as impaired as not below 1sd of 100
    }
  }
}

# Warning message for values above or below sd expectations 2sd/3sd 
observeWarningMessage <- function(score, scale, warning_message_id) {
  observe({
    # Transform the score to a standard score
    trans_score <- transform_score(score, scale, TRUE)
    # Check if the transformed score is outside the expected range
    if (!is.null(trans_score) && (trans_score > 130 | trans_score < 70)) {
      # Show the warning message if the condition is met
      shinyjs::toggle(warning_message_id, condition = TRUE)
    } else {
      # Hide the warning message if the condition is not met
      shinyjs::toggle(warning_message_id, condition = FALSE)
    }
  })
}

#generate clean IDs
sanitizeTestName <- function(test_name) {
  # Remove spaces and replace slashes with underscores
  sanitized_name <- gsub("[[:space:]]", "_", test_name)
  sanitized_name <- gsub("/", "_", sanitized_name)
  return(sanitized_name)
}


