      find_categories_for_names <- function(target_names, category_list) {
        categories <- list()
        for (target_name in target_names) {
          found_category <- NULL
          for (i in seq_along(category_list)) {
            if (target_name %in% category_list[[i]]) {
              found_category <- names(category_list)[i]
              break  # Exit the loop when a match is found
            }
          }
          categories[[target_name]] <- found_category
        }
        return(categories)
