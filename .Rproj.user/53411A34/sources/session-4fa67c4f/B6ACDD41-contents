#generate a ccategory name given a test name 
test_to_category <- function(test_name) {
  categories <- names(all_tests)
  for (category in categories) {
    if (test_name %in% all_tests[[category]]) {
      return(category)
    }
  }
  return(NA)  # If the test name is not found in any category
}

generate_modifier_output <- function(category, test_name, score) {
  modifier_output <- ""

  # 
  if (!is.na(score)) {
    score_interpretation <- score_interpretations[[category]][[test_name]]
    numeric_score <- as.numeric(score)
    
    if (!is.na(numeric_score)) {
      for (score_range in names(score_interpretation)) {
        range_values <- unlist(strsplit(score_range, "-"))
        range_min <- as.numeric(range_values[1])
        range_max <- as.numeric(range_values[2])
        
        if (numeric_score >= range_min && numeric_score <= range_max) {
          modifier_output <- paste(score_interpretation[[score_range]], " (Score range ", score_range, ")", sep = "")
          break
        }
      }
      
      # If score is not within any defined range
      if (modifier_output == "") {
        modifier_output <- paste("Selected score (", score, ") is out of range for the test ", test_name)
      }
    } else {
      modifier_output <- paste("Invalid score (", score, ") for the test ", test_name)
    }
  } else {
    modifier_output <- paste("No score provided for ", test_name)
  }
  
  return(modifier_output)
}

