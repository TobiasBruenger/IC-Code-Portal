      identify_domains <- function(category_names, domains) {
        identified_domains <- list()
        for (test_name in names(category_names)) {
          category_name <- category_names[[test_name]]
          for (domain in names(domains)) {
            if (category_name %in% domains[[domain]]) {
              identified_domains[[test_name]] <- domain
              break  # Exit the loop when a match is found
            }
          }
        }
        return(identified_domains)
      }
      
      
      generate_impairment_output <- function(threshold_label, impairment_flags, domain_names) {
        
