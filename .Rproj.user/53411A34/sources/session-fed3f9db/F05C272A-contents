# new files v13 
sfari_master <-read_csv("C:/Users/tbrunger/OneDrive - UTHealth Houston/Bioinformatics/SFARI/Searchlight Dataset v13.0/Simons_Searchlight_Dataset_v13.0/all_cohorts/measure_data/lab_results.csv") %>% 
  #select(sfari_id,sex,genetic_status,inheritance_status,has_potential_confound,latest_variant_classification,cnv_snv,c_nomen,p_nomen) %>% 
  filter(genetic_status != "Negative (normal)",
         genetic_status != "Not Tested") %>% 
  mutate(inheritance = case_when(inheritance_status == "na" | is.na(inheritance_status) | inheritance_status == "unknown" ~ "Unknown",
                                 T~paste0(str_sub(inheritance_status,1,1) %>% toupper, str_sub(inheritance_status,2,-1))),
         latest_variant_classification = case_when(is.na(latest_variant_classification) | latest_variant_classification %in% c("other","single_add","single_intragen","none")~ "Other/Unknown",
                                                   T~paste0(str_sub(latest_variant_classification,1,1) %>% toupper, str_sub(latest_variant_classification,2,-1)))
  ) %>% 
  mutate(Vartype = case_when(cnv_snv != "snv" ~"CNV",
                             str_detect(c_nomen, "\\+1[A-Z]|\\+2[A-Z]|-1[A-Z]|-2[A-Z]")~ "Splice site",
                             str_detect(c_nomen, "\\+|\\-") & !str_detect(c_nomen, "del") & !str_detect(c_nomen,"dup")~"Intronic",
                             str_detect(p_nomen, "TER|Ter|\\*|fs|X|x")~"PTV",
                             is.na(c_nomen) & is.na(p_nomen) | (c_nomen == "n/a" & p_nomen == "n/a") ~ "Other/Unknown",
                             str_detect(c_nomen, "del|dup|ins") ~ "Other/Unknown",
                             str_detect(p_nomen,"\\?")~"PTV",#start loss 
                             !is.na(p_nomen)~"Missense",
                             T~"Other/Unknown"),
         gene_group = genetic_status,
         has_potential_confound = ifelse(has_potential_confound == 0,"No", "Yes"),
         sex = ifelse(sex == "female","Female","Male")) %>% 
  select(sfari_id,sex,gene_group,inheritance,has_potential_confound,latest_variant_classification,Vartype)

