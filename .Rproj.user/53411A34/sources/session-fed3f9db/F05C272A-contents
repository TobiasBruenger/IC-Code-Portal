# Identify phenotypes with sufficient age of onset data available ####

master_dic_short.df <- read_delim("data/master_dict.txt", delim = "\t", show_col_types = F) %>% 
  mutate(phenotype = paste0("onset_",event_variable) %>% tolower()) %>% 
  select(shortname,panel,phenotype)

gene_pheno <- ndd_master %>% 
  select(-any_of(ends_with("diagnosisage")),-any_of(ends_with("maxage")),-any_of(starts_with("event"))) %>% 
  select(gene_group,starts_with("onset")) %>% 
  pivot_longer(
    cols      = -gene_group,
    names_to  = "phenotype",
    values_to = "val"
  ) 

#create fake entries to substract later but to ensure all possibilities are available 
gene_pheno_enricher <- gene_pheno %>% 
  select(gene_group,phenotype) %>% 
  distinct() %>% 
  mutate(val = 0,
         val1 = 1) %>% 
  pivot_longer(cols = c(-gene_group,-phenotype), names_to = "test", values_to = "val") %>% 
  select(-test)

pheno_ava <- bind_rows(gene_pheno,gene_pheno_enricher) %>% 
  group_by(gene_group, phenotype, val) %>%
  summarize(
    n_nonNA = sum(!is.na(val)),
    .groups = "drop"
  ) %>%  
  filter(!is.na(val)) %>% 
  mutate(n_nonNA = n_nonNA-1) %>% #substract artifical added values
  group_by(gene_group, phenotype) %>% 
  mutate(n_total = sum(n_nonNA)) %>% 
  ungroup() %>% 
  filter(n_total >= 10) %>% 
  filter(val == 1) %>% 
  mutate(frac_w_pheno = n_nonNA/n_total) %>% 
  group_by(phenotype) %>% 
  mutate(frac_w_pheno_global = sum(n_nonNA)/n_total) %>% 
  ungroup() %>% 
  mutate(global_5 = ifelse(frac_w_pheno <0.05 & frac_w_pheno_global < 0.05, "below 5", "above 5")) %>% 
  left_join(master_dic_short.df, by = c("phenotype")) 

#CACNA1A specific modification 
pheno_ava %>% 
  filter(gene_group == "CACNA1A") %>% 
  filter(frac_w_pheno != 0) %>% 
  bind_rows(pheno_ava %>% filter(gene_group != "CACNA1A")) %>% 
  write_delim("data/kaplan_phenotype_availability.txt", delim = "\t")
